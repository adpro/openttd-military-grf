if (IS_AIRCRAFT_FIGHTER_ENABLED(param_aircraft_enable_us)){
    /* F-16 group */
    item (FEAT_AIRCRAFT, item_air_f16) {
        property {
            name: string(STR_NAME_AIR_F16);
            climates_available: NO_CLIMATE; model_life: 255; vehicle_life: 255; reliability_decay: 10; cost_factor: 1; running_cost_factor: 1; 
            introduction_date: date(1976,06,01); 
            refittable_cargo_classes: bitmask(CC_MAIL, CC_EXPRESS, CC_ARMOURED, CC_LIQUID);
            sprite_id: SPRITE_ID_NEW_AIRCRAFT;
            aircraft_type: AIRCRAFT_TYPE_SMALL;
        }
        graphics {
            MAKE_AIRCRAFT_F16_GRAPHICS(STR_DESC_AIR_F16, air_f16a_default_status, 118, 554)
        }
    }

    /* F-16 A Block 1/../20 | Default camo | Internal fuel */
    item (FEAT_AIRCRAFT, item_air_f16a) {
        property {
            name: string(STR_NAME_ITEM_CAMO_CFG, string(STR_NAME_AIR_F16A), string(STR_LIV_AIR_BASE), string(STR_CFG_AIR_INTFUEL));
            PROP_F16A_INTF
            MAKE_VARIANT_TYPE(item_air_f16)
        }
        graphics {
            MAKE_AIRCRAFT_F16_GRAPHICS(STR_DESC_AIR_F16, air_f16a_default_status, 118, 554)
        }
    }
    SET_AIRCRAFT_RANGE_BASEDON_PARAM(item_air_f16a, 0, F16A_INTF_RNG)

    /* F-16 A Block 1/../20 | Default camo | External fuel */
    item (FEAT_AIRCRAFT, item_air_f16a_dflt_extfuel) {
        property {
            name: string(STR_NAME_ITEM_CAMO_CFG, string(STR_NAME_AIR_F16A), string(STR_LIV_AIR_BASE), string(STR_CFG_AIR_EXTFUEL));
            PROP_F16A_EXTF
            MAKE_VARIANT_CAMO(item_air_f16a)
        }
        graphics {
            MAKE_AIRCRAFT_F16_GRAPHICS(STR_DESC_AIR_F16, air_f16a_default_extfuel_status, 118, 554)
        }
    }
    SET_AIRCRAFT_RANGE_BASEDON_PARAM(item_air_f16a_dflt_extfuel, 0, F16A_EXTF_RNG)

    /* F-16 A Block 1/../20 | Default camo | Afterburner */
    item (FEAT_AIRCRAFT, item_air_f16a_dflt_aftb) {
        property {
            name: string(STR_NAME_ITEM_CAMO_CFG, string(STR_NAME_AIR_F16A), string(STR_LIV_AIR_BASE), string(STR_CFG_AIR_AFTB));
